services:
  qbittorrent:
    image: lscr.io/linuxserver/qbittorrent:latest
    container_name: qbittorrent
    environment:
      - PUID=1000
      - PGID=1000
      - TZ=America/Mexico_CitY
      - WEBUI_PORT= 8081
      - TORRENTING_PORT=6881
    volumes:
      - /home/ceim_admin/qbittorrent:/config
      - /mnt/scratch/qb:/data
    ports:
      - 8081:8080
      - 6881:6881
      - 6881:6881/udp
    stop_grace_period: "10s" #optional
    restart: unless-stopped
